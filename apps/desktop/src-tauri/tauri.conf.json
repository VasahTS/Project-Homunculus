{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homunculus",
  "version": "0.1.0",
  "identifier": "com.vasahts.homunculus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Homunculus",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "PortugueseBR"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4ODkxQTYyMDY0QzNDM0QKUldROVBFd0dZaHFKdU5GSFNsU3NLQmoxSHprVklzVzA4SjFGd3FxK1JJWnZURGFGSjhUY1Fzb2wK",
      "endpoints": [
        "https://github.com/VasahTS/Project-Homunculus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
