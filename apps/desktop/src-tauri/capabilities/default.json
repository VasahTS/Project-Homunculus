{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-main-commands",
    "sql:default",
    "sql:allow-execute",
    "updater:default",
    "process:allow-restart",
    "opener:default",
    "notification:default"
  ]
}
